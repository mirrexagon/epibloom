local uuid = require("epibloom.uuid")

--- Traces, an LLM converation abstraction.
local record trace
    enum Role
        --- System instructions.
        "system"
        -- Written by the user.
        "user"
        -- Generated by an LLM.
        "assistant"
    end

    --- A message from or for an LLM trace.
    record Message
        --- Who is attributed as the message author.
        role: Role
        --- The text of the message.
        content: string
        --- LLM thinking trace that can be present on assistant messages.
        thinking: string|nil
    end

    enum BackendChoice
        --- https://docs.claude.com
        "anthropic"
        --- https://featherless.ai
        "featherless"
    end

    --- An LLM trace. Can be built up with messages and then an LLM response can be generated.
    --- The messages of the trace can be accessed or set using integer keys on
    --- the trace. To append a message, set the message one past the last message.
    record Trace is {Message}
        id: uuid.Uuid

        --- Start generating a message from an LLM.
        generate: function(backend: BackendChoice, config: AnthropicConfig | FeatherlessConfig): TraceGenerateHandle

        --- Wait for any current message generation to finish.
        wait_for_generate: function()
    end


--- @class AnthropicConfig
--- @field max_tokens integer
--- @field model string
--- @field stop_sequences string[]
--- @field thinking_budget integer|nil

--- @class FeatherlessConfig
--- @field max_tokens integer
--- @field model string
--- @field temperature number|nil
--- @field top_p number|nil
--- @field top_k integer|nil
--- @field min_p number|nil
--- @field stop_sequences string[]

--- Handle to a generating message.
--- Can be used in a for loop like `for chunk in handle do end` to iterate over
--- message chunks as they are received.
--- @class TraceGenerateHandle
--- @overload fun(): TraceGenerateChunk?
local TraceGenerateHandle = {}

--- @alias TraceGenerateChunk
--- | { type: "thinking", delta: string }
--- | { type: "message", delta: string }
--- | { type: "error", message: string }

--- Block until the message generation completes.
function TraceGenerateHandle:wait() end

--- Create a new trace and return it.
--- @param name string? # The name of the new trace. If not provided, one based on the current date and time will be used.
--- @return Trace
--- @nodiscard
function trace.new(name) end

--- Get a specific trace.
--- @param trace_id TraceId # The ID of the trace to get.
--- @return Trace?
--- @return string? error_message
--- @nodiscard
function trace.get(trace_id) end


end


return trace
