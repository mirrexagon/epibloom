--- Traces, an LLM conversation abstraction.
local record trace
    --- The role of a message author.
    enum Role
        --- System instructions.
        "system"
        --- Written by the user.
        "user"
        --- Generated by an LLM.
        "assistant"
    end

    --- A message from or for an LLM trace.
    record Message
        --- Who is attributed as the message author.
        role: Role
        --- The text of the message.
        content: string
        --- LLM thinking trace that can be present on assistant messages.
        thinking: string | nil
    end

    --- Configuration for the Anthropic backend.
    --- Omitted fields use defaults.
    record AnthropicConfig
        max_tokens: integer
        model: string
        stop_sequences: {string}
        thinking_budget: integer | nil
    end

    --- Configuration for the Featherless backend.
    --- Omitted fields use defaults.
    record FeatherlessConfig
        max_tokens: integer
        model: string
        temperature: number | nil
        top_p: number | nil
        top_k: integer | nil
        min_p: number | nil
        stop_sequences: {string}
    end

    --- Which LLM backend to use for generation.
    enum BackendChoice
        --- https://docs.claude.com
        "anthropic"
        --- https://featherless.ai
        "featherless"
    end

    enum TraceGenerateChunkType
        "thinking"
        "message"
        "error"
    end

    --- A single chunk received during streaming LLM generation.
    --- `delta` is populated for "thinking" and "message" chunks.
    --- `message` is populated for "error" chunks.
    record TraceGenerateChunk
        type: TraceGenerateChunkType
        delta: string
        message: string
    end

    --- Handle to an in-progress LLM generation.
    --- Calling the handle returns the next TraceGenerateChunk, or nil when generation is done.
    --- Typical usage:
    ---   local chunk = handle()
    ---   while chunk ~= nil do ... chunk = handle() end
    record TraceGenerateHandle
        metamethod __call: function(TraceGenerateHandle): (TraceGenerateChunk | nil)
        --- Block until generation completes, discarding any remaining chunks.
        wait: function(TraceGenerateHandle)
    end

    --- An LLM trace: an ordered list of messages that can be extended and used to
    --- generate a new assistant response. Indexable as an array of Message.
    record Trace is {Message}
        --- The unique ID of this trace.
        id: string

        --- Start generating an assistant message using the given backend.
        --- config should be an AnthropicConfig or FeatherlessConfig table matching the chosen
        --- backend; if omitted, server-side defaults are used.
        generate: function(Trace, BackendChoice, config?: any): TraceGenerateHandle

        --- Wait for any ongoing generation on this trace to finish.
        wait_for_generate: function(Trace)
    end

    --- Create a new trace and return it.
    --- If name is omitted, one is generated from the current date and time.
    new: function(name?: string): Trace

    --- Get an existing trace by ID.
    --- Returns (trace, nil) on success, or (nil, error_message) if not found.
    get: function(trace_id: string): (Trace | nil, string | nil)
end

return trace
